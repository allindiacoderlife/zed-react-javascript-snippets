    "body": "document.getElementById('${1:id}')"
  },
  "Document GetElementsByClassName": {
    "prefix": "gcl",
    "body": "document.getElementsByClassName('${1:className}')"
  },
  "Document GetElementsByTagName": {
    "prefix": "gt",
    "body": "document.getElementsByTagName('${1:tagName}')"
  },
  "Document CreateElement": {
    "prefix": "cel",
    "body": "document.createElement('${1:tagName}')"
  },
  "AddEventListener": {
    "prefix": "ael",
    "body": [
      "${1:element}.addEventListener('${2:event}', (${3:e}) => {",
      "\t$0",
      "});"
    ]
  },
  "RemoveEventListener": {
    "prefix": "rel",
    "body": "${1:element}.removeEventListener('${2:event}', ${3:handler});"
  },
  "DOMContentLoaded": {
    "prefix": "domr",
    "body": [
      "document.addEventListener('DOMContentLoaded', () => {",
      "\t$0",
      "});"
    ]
  },
  "Window Load": {
    "prefix": "wl",
    "body": ["window.addEventListener('load', () => {", "\t$0", "});"]
  },
  "RequestAnimationFrame": {
    "prefix": "raf",
    "body": ["requestAnimationFrame(() => {", "\t$0", "});"]
  },
  "Generator Function": {
    "prefix": "gen",
    "body": ["function* ${1:generatorName}(${2:params}) {", "\tyield $0;", "}"]
  },
  "Async Generator": {
    "prefix": "agen",
    "body": [
      "async function* ${1:generatorName}(${2:params}) {",
      "\tyield $0;",
      "}"
    ]
  },
  "Proxy": {
    "prefix": "proxy",
    "body": [
      "new Proxy(${1:target}, {",
      "\tget(target, prop) {",
      "\t\t$0",
      "\t}",
      "})"
    ]
  },
  "Reflect Get": {
    "prefix": "rget",
    "body": "Reflect.get(${1:target}, '${2:property}')"
  },
  "Symbol": {
    "prefix": "sym",
    "body": "Symbol('${1:description}')"
  },
  "Symbol For": {
    "prefix": "symf",
    "body": "Symbol.for('${1:key}')"
  },
  "RegExp": {
    "prefix": "re",
    "body": "/${1:pattern}/${2:flags}"
  },
  "RegExp Test": {
    "prefix": "ret",
    "body": "/${1:pattern}/.test(${2:string})"
  },
  "String Match": {
    "prefix": "match",
    "body": "${1:string}.match(/${2:pattern}/${3:flags})"
  },
  "String Replace": {
    "prefix": "replace",
    "body": "${1:string}.replace(/${2:pattern}/${3:flags}, '${4:replacement}')"
  },
  "String Split": {
    "prefix": "split",
    "body": "${1:string}.split('${2:separator}')"
  },
  "String Trim": {
    "prefix": "trim",
    "body": "${1:string}.trim()"
  },
  "String Includes": {
    "prefix": "includes",
    "body": "${1:string}.includes('${2:searchString}')"
  },
  "String StartsWith": {
    "prefix": "startswith",
    "body": "${1:string}.startsWith('${2:searchString}')"
  },
  "String EndsWith": {
    "prefix": "endswith",
    "body": "${1:string}.endsWith('${2:searchString}')"
  },
  "String PadStart": {
    "prefix": "padstart",
    "body": "${1:string}.padStart(${2:targetLength}, '${3:padString}')"
  },
  "String PadEnd": {
    "prefix": "padend",
    "body": "${1:string}.padEnd(${2:targetLength}, '${3:padString}')"
  },
  "String Repeat": {
    "prefix": "repeat",
    "body": "${1:string}.repeat(${2:count})"
  },
  "Math Random": {
    "prefix": "mra",
    "body": "Math.random()"
  },
  "Math Floor": {
    "prefix": "mfl",
    "body": "Math.floor(${1:number})"
  },
  "Math Ceil": {
    "prefix": "mce",
    "body": "Math.ceil(${1:number})"
  },
  "Math Round": {
    "prefix": "mro",
    "body": "Math.round(${1:number})"
  },
  "Math Max": {
    "prefix": "mmax",
    "body": "Math.max(${1:numbers})"
  },
  "Math Min": {
    "prefix": "mmin",
    "body": "Math.min(${1:numbers})"
  },
  "Date Now": {
    "prefix": "dnow",
    "body": "Date.now()"
  },
  "New Date": {
    "prefix": "ndate",
    "body": "new Date()"
  },
  "Date ISO String": {
    "prefix": "diso",
    "body": "new Date().toISOString()"
  },
  "Use Strict": {
    "prefix": "us",
    "body": "'use strict';"
  },
  "Throw Error": {
    "prefix": "ther",
    "body": "throw new Error('${1:message}');"
  },
  "Custom Error": {
    "prefix": "cerr",
    "body": [
      "class ${1:CustomError} extends Error {",
      "\tconstructor(message) {",
      "\t\tsuper(message);",
      "\t\tthis.name = '${1:CustomError}';",
      "\t}",
      "}"
    ]
  },
  "Typeof": {
    "prefix": "tof",
    "body": "typeof ${1:variable} === '${2:type}'"
  },
  "Instanceof": {
    "prefix": "iof",
    "body": "${1:object} instanceof ${2:Class}"
  },
  "Nullish Coalescing": {
    "prefix": "nc",
    "body": "${1:value} ?? ${2:defaultValue}"
  },
  "Optional Chaining": {
    "prefix": "oc",
    "body": "${1:object}?.${2:property}"
  },
  "Comment Block": {
    "prefix": "cmt",
    "body": ["/**", " * ${1:description}", " */"]
  },
  "JSDoc Function": {
    "prefix": "jsdoc",
    "body": [
      "/**",
      " * ${1:description}",
      " * @param {${2:type}} ${3:paramName} - ${4:description}",
      " * @returns {${5:type}} ${6:description}",
      " */"
    ]
  }
}